rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra para coleção users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regra para coleção questions
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Regra para coleção shopItems
    // Formato do ID: {userId}_{timestamp}
    match /shopItems/{itemId} {
      // Permite leitura se o usuário estiver autenticado
      allow read: if request.auth != null;
      
      // Permite criar/editar/deletar itens próprios
      // Extrai o userId do itemId (antes do primeiro underscore)
      allow create, update, delete: if request.auth != null && 
        request.auth.uid == itemId.split('_')[0];
    }
    
    // Regra para coleção purchases
    match /purchases/{purchaseId} {
      // Leitura via campo userId (compatível com queries where("userId", "==", uid))
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.userId;

      // Criação: userId no documento deve bater com o usuário autenticado
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;

      // Histórico é imutável — sem update ou delete pelo cliente
      allow update, delete: if false;
    }

    // Regra para coleção answers (histórico de respostas do play)
    match /answers/{answerId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.user_id;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.user_id;

      allow update, delete: if false;
    }
  }
}
