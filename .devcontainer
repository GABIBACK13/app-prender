{
    "name": "node",
    "context": "..",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "runArgs": [
        "--userns=keep-id"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "dbaeumer.vscode-eslint"
            ]
        }
    },
    "remoteUser": "back" 
}